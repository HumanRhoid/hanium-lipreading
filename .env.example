# 애플리케이션 실행 환경(local, test, production)
APP_ENV=local

# 로컬 개발용 PostgreSQL 접속 정보
POSTGRES_DB=hanium_lipreading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hanium_lipreading

# 브라우저 요청 허용 Origin 목록(JSON 배열)
ALLOWED_ORIGINS=["http://localhost:5173"]

# 실제 모델 연동 전에는 fake,
# 모델이 없는 상태를 검증하려면 unavailable 사용
INFERENCE_BACKEND=fake

# 동시 인식 및 timeout
MAX_ACTIVE_SESSIONS=1
MAX_INFERENCE_CONCURRENCY=1
START_TIMEOUT_SECONDS=5.0
READINESS_TIMEOUT_SECONDS=2.0
SEND_TIMEOUT_SECONDS=2.0
STREAM_IDLE_TIMEOUT_SECONDS=10.0
MAX_SESSION_SECONDS=300.0

# HTTP 영상 업로드 최대 크기(기본 64 MiB)
MAX_VIDEO_UPLOAD_BYTES=67108864

# PostgreSQL 연결 풀
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10.0

# MinIO 로컬 개발 환경
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3 호환 Object Storage
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin123
OBJECT_STORAGE_BUCKET=recognition-videos
OBJECT_STORAGE_REGION=us-east-1

# Redis
REDIS_PORT=6379
REDIS_TEST_PORT=6380
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6380/0